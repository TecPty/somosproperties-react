# Canonical public host. Controls canonical URLs, hreflang, sitemap.xml and robots.txt.
# Use the production host (with www), https, no trailing slash. Preview should also point
# here so preview pages canonicalize to production instead of to *.vercel.app.
NEXT_PUBLIC_SITE_URL=https://www.somosproperties.com

NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Resend (contact form)
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Resend (employment form)
EMPLOYMENT_EMAIL_FROM=
EMPLOYMENT_EMAIL_TO=

# Optional webhooks
CONTACT_WEBHOOK_URL=
EMPLOYMENT_WEBHOOK_URL=
